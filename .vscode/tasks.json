{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Server (batch)",
      "type": "shell",
      "command": "cmd.exe",
      "args": [
        "/c",
        "${workspaceFolder}\\start_server.bat"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Flask (venv python)",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "${workspaceFolder}\\app.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Waitress (production)",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\waitress-serve.exe",
      "args": [
        "--listen=0.0.0.0:5000",
        "app:app"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
